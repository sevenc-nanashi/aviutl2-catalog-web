{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "aviutl2-catalog-web",
  "compatibility_date": "2026-08-03",
  "main": "vike:server-entry",
  "limits": {
    "cpu_ms": 250,
  },
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
    },
  },
  "cache": {
    "enabled": true,
  },
}
